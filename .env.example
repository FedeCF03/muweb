# ---------------------------------------------------------------------------
# Configuracion de muweb. Copiar a .env y ajustar.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Secreto de Flask (CSRF, sesiones). Generar: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria

# Puerto y host donde escucha Gunicorn (dentro del contenedor)
PORT=8000
GUNICORN_WORKERS=2

# Interface de red para publicar en Docker ("127.0.0.1:8000:8000")
# Para LAN: "8000:8000"
WEB_BIND=127.0.0.1:8000

# ---------------------------------------------------------------------------
# Flags de functionality. La v0 es totalmente estatica: sin base de datos.
# Cuando se active la v1 se encienden estos flags.
# ---------------------------------------------------------------------------

# Muestra el formulario de registro (deshabilitado mientras FEATURE_REGISTRATION=0)
FEATURE_REGISTRATION=0

# Muestra el estado real del server (consulta al Connect Server). Requiere v1.
FEATURE_STATUS=0

# ---------------------------------------------------------------------------
# v1: conexion a la base de datos. Dejar vacio hasta la v1.
# ---------------------------------------------------------------------------

# Base propia del CMS (noticias, descargas, admin). En la v1 vive en el mismo
# Postgres de OpenMU, en una base llamada "muweb".
# DATABASE_URL=postgresql+psycopg://muweb_app:CLAVE@database:5432/muweb

# Base de OpenMU, solo lectura (+ INSERT en Account para el registro).
# OPENMU_DATABASE_URL=postgresql+psycopg://muweb_ro:CLAVE@database:5432/openmu

# Dominio (vacio = solo LAN, http en el puerto 80)
DOMAIN=

# Directorio donde se publican los archivos de descarga del cliente.
DOWNLOADS_DIR=./downloads
